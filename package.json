{
  "name": "@solidlab/derived-resources-component",
  "version": "1.2.0",
  "description": "Adds derived resources to the Community Solid Server",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/@solidlab/derived-resources-component",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@solidlab/derived-resources-component/^1.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@solidlab/derived-resources-component/^1.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@solidlab/derived-resources-component/^1.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@solidlab/derived-resources-component/^1.0.0/dist/": "dist/"
  },
  "files": [
    "config",
    "dist"
  ],
  "scripts": {
    "start": "community-solid-server -c @css:config/file.json config/derived-auth.json -f .data -m .",
    "start:debug": "community-solid-server -c @css:config/file-root.json config/derived-auth.json -f .data -m . -t",
    "start:example": "community-solid-server -c config/main.json config/derived-auth.json config/example.json -m .",
    "start:solidbench": "community-solid-server -c config/main-solidbench-derived-multi-fixed.json config/derived-cached-store.json -f ../experiment-adaptive-link-traversal/generated/out-fragments/http/solidbench-server_3000 -b http://solidbench-server:3000 -m .",
    "start:solidbench-extension-based": "community-solid-server -c config/main-solidbench-derived-sign-mapper.json config/derived.json -f ../experiment-adaptive-link-traversal-with-extensions/generated/out-fragments/http/solidbench-server_3000 -b http://solidbench-server:3000 -m .",
    "start:solidbench-debug": "community-solid-server -c config/main-solidbench-derived-multi-fixed.json config/derived-cached-store.json -f ../experiment-adaptive-link-traversal/generated/out-fragments/http/solidbench-server_3000 -b http://solidbench-server:3000 -m . -l debug",
    "build": "npm run build:ts && npm run build:components",
    "build:components": "componentsjs-generator -s src -c dist/components -i .componentsignore -r derived",
    "build:ts": "tsc",
    "lint": "eslint . --cache --max-warnings 0",
    "test": "jest",
    "start:solidbench-hdt": "community-solid-server -c config/main-solidbench-derived-multi-fixed.json config/derived-hdt-store.json -f ../experiment-adaptive-link-traversal/generated/out-fragments/http/solidbench-server_3000 -b http://solidbench-server:3000 -m ."
  },
  "dependencies": {
    "@comunica/query-sparql-hdt": "5.0.1",
    "@rdfjs/types": "2.0.1",
    "@solid/community-server": "8.0.0-alpha.3",
    "@solidlab/policy-engine": "0.0.2",
    "@types/sparqljs": "3.1.11",
    "asynchronous-handlers": "1.0.2",
    "asynciterator": "3.10.0",
    "global-logger-factory": "1.0.0",
    "hdt": "3.3.2",
    "lru-cache": "10.4.3",
    "mime": "1.6.0",
    "n3": "2.7.12",
    "rdf-string": "1.6.3",
    "rdf-validate-shacl": "0.4.5",
    "rdf-vocabulary": "1.0.1",
    "sparqljs": "3.7.1",
    "uri-template-lite": "23.4.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@tsconfig/node18": "18.2.4",
    "@types/jest": "29.5.12",
    "@types/mime": "1.3.5",
    "@types/node": "22.20.4",
    "@types/rdf-validate-shacl": "0.4.9",
    "componentsjs-generator": "4.3.0",
    "jest": "29.7.0",
    "opinionated-eslint-config": "0.1.0",
    "rdf-js": "4.0.2",
    "ts-jest": "29.2.3",
    "typescript": "5.9.3"
  }
}
